  "fixed_sql": [
    {
      "name": "media_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"media_items\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"display_name\" TEXT NULL, \"locator\" TEXT NOT NULL UNIQUE, \"origin\" TEXT NOT NULL, \"store_id\" INTEGER NULL, \"mime_type\" TEXT NULL, \"duration_ms\" INTEGER NULL, \"size_bytes\" INTEGER NULL, \"folder\" TEXT NULL, \"artist\" TEXT NULL, \"album\" TEXT NULL, \"width\" INTEGER NULL, \"height\" INTEGER NULL, \"modified_at\" TEXT NULL, \"added_at\" TEXT NOT NULL, \"available\" INTEGER NOT NULL DEFAULT 1 CHECK (\"available\" IN (0, 1)), \"last_seen_scan\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "playback_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playback_progress\" (\"media_id\" TEXT NOT NULL REFERENCES media_items (id) ON DELETE CASCADE, \"position_ms\" INTEGER NOT NULL, \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed\" IN (0, 1)), \"last_played_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"media_id\"));"
        }
      ]
    },
    {
      "name": "user_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_preferences\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"sync_eligible\" INTEGER NOT NULL DEFAULT 0 CHECK (\"sync_eligible\" IN (0, 1)), PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "media_items_kind_title",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX media_items_kind_title ON media_items (kind, title)"
        }
      ]
    },
    {
      "name": "media_items_kind_added",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX media_items_kind_added ON media_items (kind, added_at)"
        }
      ]
    },
    {
      "name": "playback_progress_last_played",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX playback_progress_last_played ON playback_progress (last_played_at)"
        }
      ]
    }
