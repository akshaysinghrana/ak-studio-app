rules_version = '2';

// Unified Media Player: per-user metadata only (ADR 0003).
// A signed-in user can read and write only users/{their uid}/...; everything
// else is denied. Documents never contain media, file names or paths.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/playlists/{playlistId} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'updatedAt', 'deleted', 'entries'])
        && request.resource.data.updatedAt is int
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 5000
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 200));
    }

    match /users/{uid}/favorites/{fingerprint} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['favorite', 'updatedAt'])
        && request.resource.data.favorite is bool
        && request.resource.data.updatedAt is int;
    }

    match /users/{uid}/settings/{key} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 1000
        && request.resource.data.updatedAt is int;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
