<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: adaptive icon on brand navy. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_navy</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_navy</item>
        <item name="android:windowBackground">@color/brand_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brand_navy</item>
    </style>
</resources>
