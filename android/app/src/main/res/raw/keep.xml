<?xml version="1.0" encoding="utf-8"?>
<!-- Drawables that audio_service looks up by name at runtime (getIdentifier), so
     the release resource shrinker cannot see they are used. Without the
     audio_service_* control icons, the media notification fails to build: no
     notification, no lock-screen controls and no foreground service, so Android
     stops background playback after a few minutes. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_player,@drawable/audio_service_*" />
